<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		AicodeX export options for `xcodebuild -exportArchive`.

		Credentials are supplied at build time via environment variables / CI
		secrets — this file contains NO certificates, keys, or passwords.
		See APPLE_CREDENTIALS.md.

		Compliance note: the app declares `ITSAppUsesNonExemptEncryption = false`
		in its Info.plist (Apple-provided crypto only — iCloud sync, TLS), so App
		Store Connect does not prompt for export compliance on each upload. A
		`PrivacyInfo.xcprivacy` manifest ships in the app bundle. See the
		"Product registration" and "Compliance requirements" sections of
		APPLE_CREDENTIALS.md.
	-->
	<key>method</key>
	<string>app-store</string>
	<key>destination</key>
	<string>upload</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>teamID</key>
	<string>$(APPLE_TEAM_ID)</string>
	<key>uploadSymbols</key>
	<true/>
	<key>stripSwiftSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<true/>
</dict>
</plist>
